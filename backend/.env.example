# =============================================================================
# Vidyavani — Environment Variables Template
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to git.
# =============================================================================

# --- Application ---
APP_ENV=development              # development | production
APP_NAME="Vidyavani"
APP_VERSION="1.0.0"
DEBUG=true
LOG_LEVEL=INFO

# --- API Server ---
HOST=0.0.0.0
PORT=8000

# --- PostgreSQL (matches docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://vidyavani:vidyavani_secret@localhost:5432/vidyavani_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Neo4j (matches docker-compose.yml) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=vidyavani_neo4j

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Groq API (Primary LLM) — Get free key at console.groq.com ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096

# --- Google Gemini (Fallback LLM) — Get key at aistudio.google.com ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Ollama (Offline Fallback) — runs locally, no key needed ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu              # cpu | cuda (if GPU available)

# --- Supabase (Auth + Storage + Realtime) ---
# Get from: supabase.com > Project Settings > API
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- File Storage ---
RESUME_UPLOAD_DIR=./uploads/resumes
NSQF_PDF_DIR=./data/nsqf_pdfs
MAX_FILE_SIZE_MB=10

# --- CORS ---
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- Background Jobs ---
ARQ_MAX_JOBS=10
SCRAPE_INTERVAL_HOURS=24         # How often the scraper runs
